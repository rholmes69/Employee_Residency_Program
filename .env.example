# ─────────────────────────────────────────────────────────────
# Employee Residency Program — environment configuration
# Copy to .env and fill in. docker-compose overrides the
# hostnames (db, mcp, mailpit) for containers automatically.
# ─────────────────────────────────────────────────────────────

# Public URL users open in the browser (used in email links)
APP_URL=http://localhost:8080

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=residency
# Used for local (non-Docker) dev; Docker publishes Postgres on 5433
DATABASE_URL=postgresql://erp:change-me-strong-password@localhost:5433/residency?schema=public

# ── Security ─────────────────────────────────────────────────
# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=replace-with-64-random-hex-chars
MCP_SHARED_SECRET=replace-with-another-64-random-hex-chars
# Set true when served over HTTPS
COOKIE_SECURE=false

# ── Microsoft Entra ID (Azure AD) SSO ────────────────────────
# App registration → "Single-page application" platform,
# redirect URI = APP_URL. Optional app roles: "Reviewer", "Admin".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Comma-separated email domains allowed to sign in
ENTRA_ALLOWED_DOMAINS=deltahealthcenter.org
# Emails that are always ADMIN (bootstrap)
ADMIN_EMAILS=

# DEV ONLY — lets you sign in as any email/role without SSO.
# MUST be false in production.
AUTH_DEV_LOGIN=true

# ── Email (SMTP) ─────────────────────────────────────────────
# Defaults point at the Mailpit container (view mail at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Employee Residency Program <residency@deltahealthcenter.org>"
# HR inbox notified when applications clear supervisor sign-off
HR_NOTIFY_EMAIL=vspann@deltahealthcenter.org

# ── Ollama (local LLMs) ──────────────────────────────────────
# Local dev: Ollama on this machine. In Docker we use host.docker.internal.
OLLAMA_URL=http://127.0.0.1:11434
# Agent model: needs reliable tool calling. qwen3:4b-instruct (non-thinking) fits CPU-only 24 GB machines; with a 12 GB+ GPU use qwen3:8b or qwen3:14b
OLLAMA_AGENT_MODEL=qwen3:4b-instruct
# Writing help + rationales. Same as the agent model = one model in RAM (best on CPU-only hosts)
OLLAMA_FAST_MODEL=qwen3:4b-instruct
# Embedding model for mentor matching
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# qwen3 "thinking" is slow on CPU; false disables it. Remove if your model rejects the flag.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_MS=420000
# Agent context window (persona + tool schemas need > 4096)
OLLAMA_NUM_CTX=8192

# ── MCP server ───────────────────────────────────────────────
MCP_URL=http://localhost:4100/mcp
# Optional: lets an external MCP client (e.g. Claude Desktop) connect
# with `Authorization: Bearer <token>` acting as the given user.
MCP_SERVICE_TOKEN=
MCP_SERVICE_USER_EMAIL=
