{
  "name": "employee-residency-program",
  "private": true,
  "version": "1.0.0",
  "description": "Delta Health Center Employee Residency Program — application platform with a local-LLM agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @erp/api",
    "dev:mcp": "npm run dev -w @erp/mcp",
    "dev:web": "npm run dev -w @erp/web",
    "build": "npm run build -w @erp/api && npm run build -w @erp/mcp && npm run build -w @erp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env packages/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.16.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
